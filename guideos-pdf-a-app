import sys
import os
import subprocess
import threading

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Gtk, Adw, GLib, Gio, Gio as GioSys

class OCRApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.example.pdfocrmypdf", flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.connect("activate", self.on_activate)

    def on_activate(self, app):
        self.win = OCRWindow(application=app)
        self.win.present()

class OCRWindow(Adw.ApplicationWindow):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.set_title("GuideOS-PDF/A Konverter")
        self.set_default_size(520, 500)

        # Haupt-Container
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.set_content(main_box)

        # HeaderBar
        header = Adw.HeaderBar()
        main_box.append(header)

        # ScrolledWindow für Flexibilität auf kleinen Bildschirmen
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_vexpand(True)
        main_box.append(scrolled)

        # Clamp hält den Inhalt auf eine angenehme Breite zentriert
        clamp = Adw.Clamp()
        clamp.set_maximum_size(480)
        scrolled.set_child(clamp)

        # Inhalts-Box (zentriert im Fenster)
        self.content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        self.content_box.set_valign(Gtk.Align.CENTER)
        self.content_box.set_margin_top(24)
        self.content_box.set_margin_bottom(24)
        self.content_box.set_margin_start(24)
        self.content_box.set_margin_end(24)
        clamp.set_child(self.content_box)

        self.last_output_dir = None
        self.build_ui()

    def build_ui(self):
        # 1. Eigenes Header-Layout (statt starrer StatusPage)
        self.icon = Gtk.Image.new_from_icon_name("document-open-recent-symbolic")
        self.icon.set_pixel_size(96)
        self.icon.add_css_class("dim-label")
        self.content_box.append(self.icon)

        self.lbl_title = Gtk.Label(label="PDFs durchsuchbar machen")
        self.lbl_title.add_css_class("title-1")
        self.content_box.append(self.lbl_title)

        self.lbl_subtitle = Gtk.Label(label="Wähle PDF-Dateien aus, um die Texterkennung (OCR) zu starten.")
        self.lbl_subtitle.add_css_class("body")
        self.lbl_subtitle.set_wrap(True)
        self.lbl_subtitle.set_justify(Gtk.Justification.CENTER)
        self.lbl_subtitle.add_css_class("dim-label")
        self.content_box.append(self.lbl_subtitle)

        # Auswahl-Button
        self.btn_select = Gtk.Button(label="PDF-Dateien auswählen")
        self.btn_select.add_css_class("suggested-action")
        self.btn_select.add_css_class("pill")
        self.btn_select.set_halign(Gtk.Align.CENTER)
        self.btn_select.set_margin_top(8)
        self.btn_select.connect("clicked", self.on_select_files)
        self.content_box.append(self.btn_select)

        # 2. Fortschrittskarte (PreferencesGroup)
        self.progress_group = Adw.PreferencesGroup()
        self.progress_group.set_title("Status")
        self.progress_group.set_margin_top(12)
        self.progress_group.set_visible(False)
        self.content_box.append(self.progress_group)

        card_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        card_box.set_margin_top(12)
        card_box.set_margin_bottom(12)
        card_box.set_margin_start(16)
        card_box.set_margin_end(16)
        self.progress_group.add(card_box)

        # Statuszeile & Fortschrittsbalken
        self.lbl_status = Gtk.Label(label="Bereit...")
        self.lbl_status.set_halign(Gtk.Align.START)
        self.lbl_status.set_ellipsize(3)
        card_box.append(self.lbl_status)

        self.progress_bar = Gtk.ProgressBar()
        self.progress_bar.set_show_text(True)
        card_box.append(self.progress_bar)

        # Ordner-Öffnen-Button
        self.btn_open_folder = Gtk.Button(label="Zielordner öffnen")
        self.btn_open_folder.add_css_class("flat")
        self.btn_open_folder.set_halign(Gtk.Align.END)
        self.btn_open_folder.set_visible(False)
        self.btn_open_folder.connect("clicked", self.on_open_folder_clicked)
        card_box.append(self.btn_open_folder)

    def on_select_files(self, widget):
        dialog = Gtk.FileDialog()
        dialog.set_title("PDF-Dateien auswählen")

        filter_pdf = Gtk.FileFilter()
        filter_pdf.set_name("PDF-Dateien (*.pdf)")
        filter_pdf.add_mime_type("application/pdf")

        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(filter_pdf)
        dialog.set_filters(filters)

        dialog.open_multiple(self, None, self.on_files_selected)

    def on_files_selected(self, dialog, result):
        try:
            files_list = dialog.open_multiple_finish(result)
            paths = [f.get_path() for f in files_list if f.get_path()]
            if paths:
                self.start_ocr_process(paths)
        except Exception:
            pass

    def start_ocr_process(self, file_paths):
        self.btn_select.set_sensitive(False)
        self.btn_open_folder.set_visible(False)

        self.progress_group.set_visible(True)
        self.progress_bar.set_fraction(0.0)
        self.lbl_status.set_text("Starte Verarbeitung...")

        thread = threading.Thread(target=self.run_ocr_thread, args=(file_paths,))
        thread.daemon = True
        thread.start()

    def run_ocr_thread(self, file_paths):
        total = len(file_paths)
        last_dir = None

        for index, path in enumerate(file_paths, start=1):
            folder = os.path.dirname(path)
            filename = os.path.basename(path)
            out_folder = os.path.join(folder, "pdfa_output")
            os.makedirs(out_folder, exist_ok=True)
            out_path = os.path.join(out_folder, filename)
            last_dir = out_folder

            GLib.idle_add(self.update_ui_status, f"Verarbeite ({index}/{total}): {filename}", (index - 1) / total)

            cmd = ["ocrmypdf", "-l", "deu", "--skip-text", "--output-type", "pdfa", path, out_path]
            subprocess.run(cmd)

            GLib.idle_add(self.update_ui_status, f"Fertig ({index}/{total}): {filename}", index / total)

        self.last_output_dir = last_dir
        GLib.idle_add(self.on_ocr_finished)

    def update_ui_status(self, text, fraction):
        self.lbl_status.set_text(text)
        self.progress_bar.set_fraction(fraction)

    def on_ocr_finished(self):
        self.btn_select.set_sensitive(True)
        self.lbl_status.set_text("<b>Alle Dateien erfolgreich umgewandelt!</b>")
        self.lbl_status.set_use_markup(True)

        if self.last_output_dir and os.path.exists(self.last_output_dir):
            self.btn_open_folder.set_visible(True)

    def on_open_folder_clicked(self, widget):
        if self.last_output_dir:
            GioSys.AppInfo.launch_default_for_uri(f"file://{self.last_output_dir}", None)

if __name__ == "__main__":
    app = OCRApp()
    app.run(sys.argv)
